# Copy to `.env` (same directory) and fill in whatever you have.
# src/common.py loads this automatically on every run. `.env` is gitignored.
# Leave a line out entirely if you don't have that key — do not set it empty.
#
# Only the providers actually used in the published run are listed first.
# The lineup needs >=2 proprietary and >=2 open-weights models; see config.yaml.

# --- proprietary ---
ANTHROPIC_API_KEY=          # claude-haiku-4-5, claude-sonnet-5 (paid)
GEMINI_API_KEY=             # gemini-flash-lite-latest (free tier, 500 req/day)

# --- open-weights ---
TOGETHER_API_KEY=           # llama-3.3-70b-instruct-turbo (paid, ~$1.24/run)
MISTRAL_API_KEY=            # mistral-small-latest (free tier)
GROQ_API_KEY=               # llama-3.1-8b-instant (free tier)

# --- evaluated but not used in the published run ---
# OPENAI_API_KEY=           # gpt-4o-mini; dropped (account had no credits)
# CEREBRAS_API_KEY=         # dropped: no Llama in catalogue, and 402 on all models

# Optional: only needed to use the gated TweetSumm dataset instead of the
# DialogSum fallback. See results/NOTES.md section 2.
# HF_TOKEN=
